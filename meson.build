project(
  'starfall',
  ['c', 'vala'],
  version : '0.1.0',
  meson_version : '>= 1.1.0',
  default_options : [
    # Vala generates the C we compile, so keep C warnings quiet (level 2 just
    # floods the log with unused-parameter noise from generated code).
    'warning_level=1',
    'buildtype=debugoptimized',
  ],
)

# The Vala runtime (GObject classes, arrays, strings).
glib_deps = [
  dependency('glib-2.0'),
  dependency('gobject-2.0'),
]

# libm, for sinf/sqrtf used in the game code itself.
m_dep = meson.get_compiler('c').find_library('m', required : false)

# raylib: use a system install if one is present, otherwise build the pinned
# version from source via subprojects/raylib.wrap.
raylib_dep = dependency(
  'raylib',
  version : '>= 5.0',
  fallback : ['raylib', 'raylib_dep'],
)

# Hand-written Vala bindings live in vapi/raylib.vapi.
add_project_arguments(
  ['--vapidir', meson.current_source_dir() / 'vapi'],
  language : 'vala',
)

sources = files(
  'src/main.vala',
  'src/game.vala',
  'src/screen.vala',
  'src/title_screen.vala',
  'src/play_screen.vala',
  'src/score_screen.vala',
  'src/settings_screen.vala',
  'src/settings.vala',
  'src/level.vala',
  'src/boss.vala',
  'src/scores.vala',
  'src/entity.vala',
  'src/player.vala',
  'src/bullet.vala',
  'src/enemy.vala',
  'src/beam.vala',
  'src/special.vala',
  'src/starfield.vala',
  'src/planet.vala',
  'src/assets.vala',
  'src/audio.vala',
  'src/fx.vala',
)

executable(
  'starfall',
  sources,
  vala_args : ['--pkg', 'raylib'],
  dependencies : glib_deps + [raylib_dep, m_dep],
  install : true,
)

# Sprite atlas (generated by tools/gen_sprites.py). Installed alongside the
# binary's data dir; in a dev tree the game finds ./assets/sprites directly.
install_subdir(
  'assets/sprites',
  install_dir : get_option('datadir') / meson.project_name(),
  exclude_files : ['preview.png'],
)

install_subdir(
  'assets/sounds',
  install_dir : get_option('datadir') / meson.project_name(),
)
